<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="iPhoneMiror.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0A0A0B" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#FF0A0A0B" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF151517" />
                    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#FF1C1C1F" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF26262A" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#FF6E6E73" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FF1F1F22" />
                    <SolidColorBrush x:Key="DisplayStageBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF34C759" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFFFB340" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#FFFF453A" />
                    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF636366" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#FFF9F9FA" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE3E3E6" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF5F5F64" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FFEBEBED" />
                    <SolidColorBrush x:Key="DisplayStageBrush" Color="#FF111113" />
                    <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF248A3D" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFB25000" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#FFD70015" />
                    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF8E8E93" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Monochrome accent: white on dark, charcoal on light. -->
            <Color x:Key="SystemAccentColor">#FFE5E5E7</Color>
            <Color x:Key="SystemAccentColorLight1">#FFEDEDEF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF5F5F7</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2C2C2E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1C1C1E</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0E0E10</Color>


            <!-- Shared styles (kept in this dictionary so they can resolve the theme brushes above). -->
            <CornerRadius x:Key="CardCornerRadius">14</CornerRadius>
            <Thickness x:Key="CardPadding">20,18,20,18</Thickness>
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
                <Setter Property="Padding" Value="{StaticResource CardPadding}" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-10" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="CaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource FaintTextBrush}" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <Style x:Key="ValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="PillStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PillBackgroundBrush}" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,4,10,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
