<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="iPhoneMiror.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Monochrome accent: white on dark, charcoal on light. -->
            <Color x:Key="SystemAccentColor">#FFE5E5E7</Color>
            <Color x:Key="SystemAccentColorLight1">#FFEDEDEF</Color>
            <Color x:Key="SystemAccentColorLight2">#FFF5F5F7</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFFFFFF</Color>
            <Color x:Key="SystemAccentColorDark1">#FF2C2C2E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF1C1C1E</Color>
            <Color x:Key="SystemAccentColorDark3">#FF0E0E10</Color>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0A0A0B" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#FF0A0A0B" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF151517" />
                    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#FF1C1C1F" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF26262A" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFA1A1A6" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#FF6E6E73" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FF1F1F22" />
                    <SolidColorBrush x:Key="DisplayStageBrush" Color="#FF000000" />
                    <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF34C759" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFFFB340" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#FFFF453A" />
                    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF636366" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="AppTitleBarBrush" Color="#FFF4F4F5" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#FFF9F9FA" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE3E3E6" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF5F5F64" />
                    <SolidColorBrush x:Key="FaintTextBrush" Color="#FF8E8E93" />
                    <SolidColorBrush x:Key="PillBackgroundBrush" Color="#FFEBEBED" />
                    <SolidColorBrush x:Key="DisplayStageBrush" Color="#FF111113" />
                    <SolidColorBrush x:Key="StatusGoodBrush" Color="#FF248A3D" />
                    <SolidColorBrush x:Key="StatusWarnBrush" Color="#FFB25000" />
                    <SolidColorBrush x:Key="StatusBadBrush" Color="#FFD70015" />
                    <SolidColorBrush x:Key="StatusIdleBrush" Color="#FF8E8E93" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
