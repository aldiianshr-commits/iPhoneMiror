<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iPhoneMiror.App.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:iPhoneMiror.App.ViewModels"
    xmlns:conv="using:iPhoneMiror.App.Converters"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="18" MaxWidth="1000" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Apple Account" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0"
                           Text="Optional identity sign-in with Apple's official Sign in with Apple service. Your password is entered only on Apple's own web page and is never seen or stored by iPhoneMiror." />
            </StackPanel>

            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="What signing in does — and doesn't do"
                     Message="Signing in verifies your Apple ID identity. It does not unlock Apple's iPhone Mirroring feature, which is private to macOS. Mirroring in iPhoneMiror works without an Apple Account." />

            <!-- Status -->
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource PillBackgroundBrush}">
                        <FontIcon Glyph="&#xE77B;" FontSize="22" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind conv:Bind.Indicator(ViewModel.Indicator), Mode=OneWay}" />
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.AccountText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.VerifiedText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SignInCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                                <TextBlock Text="Sign in with Apple" />
                            </StackPanel>
                        </Button>
                        <Button Content="Sign out" Command="{x:Bind ViewModel.SignOutCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Configuration -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="Account integration" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Sign in with Apple requires a Services ID from an Apple Developer account and an HTTPS redirect URI registered for it. Host the relay page from tools/apple-signin-relay (for example on GitHub Pages) at that URI; it returns the result to iPhoneMiror through the iphonemiror:// link." />
                    <TextBox Header="Services ID (client_id)" PlaceholderText="com.example.iphonemiror.signin" Text="{x:Bind ViewModel.ServicesId, Mode=TwoWay}" />
                    <TextBox Header="Redirect URI (https)" PlaceholderText="https://you.github.io/apple-signin-relay/" Text="{x:Bind ViewModel.RedirectUri, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Save" Command="{x:Bind ViewModel.SaveConfigCommand}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.ConfigMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Device pairing information -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="Device pairing information" />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Device trust is separate from your Apple Account: each iPhone trusts this PC through its own pairing record (created when you tap “Trust”)." />
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="No devices yet." Visibility="{x:Bind conv:Bind.VisibleIfNone(ViewModel.Pairings.Count), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Pairings}">
                        <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:PairingInfoItem">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" IsTextSelectionEnabled="True" Text="{x:Bind Udid}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}">
                                        <Run Text="{x:Bind Pairing}" /> · <Run Text="{x:Bind Connection}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
