<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="iPhoneMiror.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:iPhoneMiror.App.ViewModels"
    xmlns:compat="using:iPhoneMiror.Core.Compatibility"
    xmlns:conv="using:iPhoneMiror.App.Converters"
    Background="Transparent">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="16" ColumnSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Device Manager" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0" Text="Every iPhone seen by iPhoneMiror, with live connection, pairing and compatibility details." />
        </StackPanel>

        <!-- List -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="6">
            <Grid>
                <ListView ItemsSource="{x:Bind ViewModel.Hub.Devices}" SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                            <Grid Padding="4,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource PillBackgroundBrush}">
                                    <FontIcon Glyph="{x:Bind StatusGlyph, Mode=OneWay}" FontSize="17" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{x:Bind Name, Mode=OneWay}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind conv:Bind.DeviceStatus(IsConnected, IsAttached), Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind StatusText, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ConnectionText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Padding="20"
                            Visibility="{x:Bind conv:Bind.Collapsed(ViewModel.Hub.HasDevices), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8EA;" FontSize="30" Foreground="{ThemeResource FaintTextBrush}" />
                    <TextBlock HorizontalAlignment="Center" Text="No devices yet" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource CaptionStyle}" TextAlignment="Center" Text="Connect an iPhone over USB to see it here." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind conv:Bind.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
                    <TextBlock Style="{StaticResource CaptionStyle}" Text="Select a device to see its details." />
                </Border>

                <StackPanel Spacing="14" Visibility="{x:Bind conv:Bind.Visible(ViewModel.HasSelection), Mode=OneWay}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock Style="{StaticResource CaptionStyle}" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Selected.Udid, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>
                            <Grid ColumnSpacing="12" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="MODEL" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.Model, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="IOS VERSION" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.IosVersionText, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="CONNECTION" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.ConnectionText, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="BATTERY" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.BatteryText, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="STATUS" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.StatusText, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="TRUST" />
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Selected.PairingText, Mode=OneWay, FallbackValue=''}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionStyle}" Foreground="{ThemeResource StatusWarnBrush}" Text="{x:Bind ViewModel.Selected.DetailText, Mode=OneWay, FallbackValue=''}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Content="Start Mirroring" Command="{x:Bind ViewModel.MirrorCommand}" />
                                <Button Content="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" />
                                <Button Content="Trust / Pair" Command="{x:Bind ViewModel.PairCommand}" />
                                <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectCommand}" />
                                <Button Content="Reconnect" Command="{x:Bind ViewModel.ReconnectCommand}" />
                                <Button Content="Forget" Command="{x:Bind ViewModel.ForgetCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Margin="0" Text="Compatibility" />
                            <TextBlock Style="{StaticResource CaptionStyle}" Text="{x:Bind ViewModel.Selected.CompatibilitySummary, Mode=OneWay, FallbackValue=''}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Selected.Features, Mode=OneWay}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="compat:FeatureCompatibility">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="230" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Bind Feature}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionStyle}" Text="{x:Bind conv:Bind.SupportText(Support)}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionStyle}" Text="{x:Bind Detail}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
