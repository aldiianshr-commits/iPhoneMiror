<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iPhoneMiror.App.Views.DisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:iPhoneMiror.App.Converters"
    Title="iPhoneMiror Display">

    <Grid x:Name="Root" KeyDown="Root_KeyDown" CharacterReceived="Root_CharacterReceived">
        <Grid.Resources>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="ToolbarToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBarArea" Padding="14,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind conv:Bind.Indicator(ViewModel.Indicator), Mode=OneWay}" />
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="iPhoneMiror Display" VerticalAlignment="Center" />
                <TextBlock FontSize="12" Foreground="{ThemeResource SubtleTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{x:Bind ViewModel.SelectedDevice.Name, Mode=OneWay, FallbackValue=''}" />
            </StackPanel>
        </Grid>

        <!-- Stage -->
        <Grid Grid.Row="1" Background="{ThemeResource DisplayStageBrush}">
            <ScrollViewer x:Name="Scroller" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          IsTabStop="True" SizeChanged="Scroller_SizeChanged">
                <Grid x:Name="Stage">
                    <Image x:Name="Screen" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                           PointerPressed="Screen_PointerPressed" PointerMoved="Screen_PointerMoved"
                           PointerReleased="Screen_PointerReleased" PointerCanceled="Screen_PointerCanceled"
                           PointerWheelChanged="Screen_PointerWheelChanged" />
                </Grid>
            </ScrollViewer>

            <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360" Padding="24">
                <FontIcon Glyph="&#xE8EA;" FontSize="40" Foreground="#FF8E8E93" />
                <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" Foreground="White" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#FFA1A1A6" Text="{x:Bind ViewModel.StateDetail, Mode=OneWay}" />
                <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Content="Start Mirroring" Command="{x:Bind ViewModel.StartCommand}" />
            </StackPanel>

            <InfoBar x:Name="Toast" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12" IsOpen="False" Severity="Success" IsClosable="True" />
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="2" Padding="10,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"
                       Text="{x:Bind ViewModel.StatsText, Mode=OneWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button x:Name="StartButton" ToolTipService.ToolTip="Start mirroring" Command="{x:Bind ViewModel.StartCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                </Button>
                <Button ToolTipService.ToolTip="Stop mirroring" Command="{x:Bind ViewModel.StopCommand}" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE71A;" FontSize="15" />
                </Button>
                <AppBarSeparator />
                <Button ToolTipService.ToolTip="Home (Ctrl+Shift+H)" Click="Home_Click" Style="{StaticResource ToolbarButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.InputAvailable, Mode=OneWay}">
                    <FontIcon Glyph="&#xE80F;" FontSize="15" />
                </Button>
                <ToggleButton ToolTipService.ToolTip="Mouse and keyboard control" IsChecked="{x:Bind ViewModel.IsInputEnabled, Mode=TwoWay}" Style="{StaticResource ToolbarToggleStyle}">
                    <FontIcon Glyph="&#xE962;" FontSize="15" />
                </ToggleButton>
                <AppBarSeparator />
                <Button ToolTipService.ToolTip="Zoom out" Click="ZoomOut_Click" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE71F;" FontSize="15" />
                </Button>
                <Button ToolTipService.ToolTip="Fit to window" Click="ZoomFit_Click" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE9A6;" FontSize="15" />
                </Button>
                <Button ToolTipService.ToolTip="Zoom in" Click="ZoomIn_Click" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE8A3;" FontSize="15" />
                </Button>
                <Button ToolTipService.ToolTip="Portrait / landscape window" Click="Rotate_Click" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE7AD;" FontSize="15" />
                </Button>
                <Button ToolTipService.ToolTip="Fullscreen (F11)" Click="Fullscreen_Click" Style="{StaticResource ToolbarButtonStyle}">
                    <FontIcon Glyph="&#xE740;" FontSize="15" />
                </Button>
                <Button x:Name="ScreenshotButton" ToolTipService.ToolTip="Save screenshot" Click="Screenshot_Click" Style="{StaticResource ToolbarButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.IsStreaming, Mode=OneWay}">
                    <FontIcon Glyph="&#xE722;" FontSize="15" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind conv:Bind.Status(ViewModel.InputAvailable), Mode=OneWay}" />
                <TextBlock FontSize="11" Foreground="{ThemeResource SubtleTextBrush}" Text="Control" VerticalAlignment="Center"
                           ToolTipService.ToolTip="{x:Bind ViewModel.InputStatusText, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
