<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="iPhoneMiror.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:iPhoneMiror.App.Converters"
    Title="iPhoneMiror">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="18,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/AppIcon.png" Width="18" Height="18" />
                <TextBlock Text="iPhoneMiror" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource PillStyle}" Padding="9,3,10,3" Margin="6,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{x:Bind conv:Bind.Status(Hub.ServiceAvailable), Mode=OneWay}" />
                        <TextBlock FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource SubtleTextBrush}"
                                   Text="{x:Bind conv:Bind.ServiceText(Hub.ServiceAvailable), Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="232"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="dashboard">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connect iPhone" Tag="connect">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE71B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Device Manager" Tag="devices">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Mirroring" Tag="mirroring">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Apple Account" Tag="account">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
